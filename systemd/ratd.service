[Unit]
Description=ratd mouse configuration service
PartOf=graphical-session.target
After=graphical-session.target
# Only reached when systemd gives up restarting it (5 failures in 10 s)
OnFailure=ratd-failed.service

[Service]
Environment=PYTHONPATH=%h/Projects/ratd
ExecStart=/usr/bin/python3 -m ratd
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
